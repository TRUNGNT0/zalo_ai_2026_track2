{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BusinessManifest",
  "$defs": {
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_role",
        "source_files",
        "columns",
        "source_refs"
      ],
      "properties": {
        "table_role": {
          "enum": [
            "sales_records",
            "unit_conversions",
            "stock_snapshots",
            "purchase_lines",
            "price_history"
          ]
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "$ref": "#/$defs/references"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "value",
        "source_refs"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/references"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "reason",
        "needed_evidence"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "needed_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "business_id",
        "tables",
        "facts",
        "unresolved"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "business_id": {
          "type": "string",
          "minLength": 1
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/table"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "business_id": {
          "type": "string",
          "minLength": 1
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "source_object": {
                "type": "string",
                "minLength": 1
              },
              "table_role": {
                "enum": [
                  "sales_records",
                  "sales_orders",
                  "sales_lines",
                  "payments",
                  "returns",
                  "unit_conversions",
                  "stock_snapshots",
                  "stock_movements",
                  "purchase_orders",
                  "purchase_lines",
                  "price_history",
                  "products",
                  "customers",
                  "suppliers",
                  "employees",
                  "branches",
                  "lots",
                  "lot_allocations",
                  "drug_info",
                  "expenses",
                  "calendar",
                  "unknown"
                ]
              },
              "grain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "header_row_number": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "semantic_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "enum": [
                        "documented",
                        "inferred_candidate",
                        "unresolved"
                      ]
                    },
                    "source_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "unit_basis": {
                      "enum": [
                        "sale_unit",
                        "purchase_unit",
                        "base_unit",
                        "currency",
                        "not_applicable",
                        "unknown"
                      ]
                    },
                    "time_role": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "aggregation": {
                      "enum": [
                        "sum",
                        "last",
                        "weighted_average",
                        "none",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "source_name",
                    "semantic_name",
                    "description",
                    "status",
                    "source_refs",
                    "unit_basis",
                    "time_role",
                    "aggregation"
                  ]
                }
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "source_file",
              "source_object",
              "table_role",
              "grain",
              "header_row_number",
              "columns",
              "source_refs"
            ]
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "relationship_id": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_object": {
                    "type": "string",
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "source_file",
                  "source_object",
                  "columns"
                ]
              },
              "to": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_object": {
                    "type": "string",
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "source_file",
                  "source_object",
                  "columns"
                ]
              },
              "cardinality": {
                "enum": [
                  "many_to_one",
                  "one_to_one"
                ]
              },
              "source": {
                "enum": [
                  "readme",
                  "sqlite_foreign_key",
                  "inferred_candidate"
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "relationship_id",
              "from",
              "to",
              "cardinality",
              "source",
              "source_refs"
            ]
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "fact_id",
              "value",
              "source_refs"
            ]
          }
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "reason",
              "needed_evidence"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "needed_evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "required": [
        "schema_version",
        "business_id",
        "tables",
        "relationships",
        "facts",
        "rule_refs",
        "unresolved"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BusinessManifest v2"
    }
  ]
}
